{
  "name": "adapty-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol (MCP) server for Adapty — full coverage of Server-Side API v2, legacy v1, Web API, Analytics Export, and webhook utilities.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "adapty",
    "subscriptions",
    "in-app-purchase",
    "iap",
    "storekit",
    "revenue",
    "claude",
    "cursor"
  ],
  "homepage": "https://github.com/devinwang/adapty-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devinwang/adapty-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/devinwang/adapty-mcp/issues"
  },
  "license": "MIT",
  "author": "Devin Wang",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "adapty-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/index.js",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist coverage",
    "verify": "npm run typecheck && npm run test && npm run build",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "~1.0.4",
    "undici": "^6.21.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "msw": "^2.6.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
